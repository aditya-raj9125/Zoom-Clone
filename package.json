{
  "name": "zoom-clone-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Zoom Clone — Fullstack Monorepo",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "start:web": "npm --prefix apps/web run start",
    "lint:web": "npm --prefix apps/web run lint"
  }
}
