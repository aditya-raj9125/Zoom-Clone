# Application
APP_NAME=zoom-clone
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/zoom_clone.db

# API
API_PREFIX=/api/v1

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
